# Salin file ini menjadi .env lalu isi sesuai database di komputer masing-masing
DB_HOST=localhost
DB_PORT=3306
DB_USER=absen
DB_PASSWORD=ganti_sandi
DB_NAME=absen_nfc
# Khusus Linux yang memakai soket, kosongkan kalau tidak tahu
DB_SOCKET=

# Keamanan: kunci untuk ESP32 (header X-API-Key) dan login dashboard
API_KEY=ganti_kunci_acak
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=ganti_sandi_dashboard

# Teks acak panjang untuk menandatangani cookie login dashboard
SESSION_SECRET=ganti_teks_acak_panjang
